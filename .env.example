# Copy to .env for host-dev or to override Compose defaults.

POSTGRES_USER=workos
POSTGRES_PASSWORD=workos
POSTGRES_DB=workos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host-dev only (api/web on the machine). Compose points the API at host `db`.
DATABASE_URL=postgresql+psycopg://workos:workos@127.0.0.1:5432/workos

API_HOST=0.0.0.0
API_PORT=8081
WEB_PORT=3001
SECRET_KEY=change-me
SESSION_DAYS=30
WEB_ORIGIN=http://localhost:3001

NEXT_PUBLIC_API_URL=http://127.0.0.1:8081

# First boot creates this platform admin if none exists.
ADMIN_EMAIL=admin@workos.dev
ADMIN_PASSWORD=Admin1234
ADMIN_NAME=Admin
# Public /register is closed. Only a platform admin can create users.
PUBLIC_REGISTER=false

# Phone OTP. console logs the code (and returns dev_code). twilio sends SMS.
PHONE_DEFAULT_COUNTRY=82
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
